/* 로그인·회원가입 창 전용 스타일시트.
 *
 * 이 시트는 앱 테마(라이트/다크 토글)와 무관하게 항상 다크 팔레트로 고정된다
 * (ThemeManager::dialogStyleSheet()가 kDark 값만 치환한다).
 *
 * 적용 방식도 다른 화면과 다르다 — qApp이 아니라 LoginDialog/SignupDialog가
 * 각자 자기 자신에게 직접(this->setStyleSheet(...)) 건다. 앱 레벨로 올리면
 * 아래의 bare 타입 규칙(QDialog {...}, QLabel { color: ... })이 앱 전역으로
 * 새어나가 라이트 테마의 메인 화면까지 다크 색으로 물들인다.
 * 다음에 이 시트를 보고 "왜 qApp에 안 태우지?" 싶다면 이 문단이 답이다 —
 * 임의로 승격하지 말 것.
 */
        QDialog { background: %(bgDeep); }
        #authCard { background: %(panel); }

        /* 로그인 창 전용 "유리" 카드.
         * LoginDialog::paintEvent()가 그린 블러 배경 위에 얹히므로 배경이
         * 반투명(rgba)이다 — 자식 위젯은 부모가 먼저 그려진 뒤에 그려지기
         * 때문에 알파가 그대로 섞인다. 회원가입 창의 #authCard는 불투명
         * 배경 위에 있어 같은 값을 주면 탁해지므로 이름을 분리해 뒀다. */
        #authGlassCard { background: rgba(21, 29, 38, 0.72);
                         border: 1px solid rgba(255, 255, 255, 0.10);
                         border-radius: 18px; }
        QLabel { color: %(text); font-family: "Segoe UI", "맑은 고딕", "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans CJK KR", "Noto Sans KR", sans-serif; }

        #authLogo { color: %(accent); font-size: 38px; font-weight: 800; letter-spacing: 4px; }
        #authTitle { color: %(text); font-size: 20px; font-weight: 800; }
        #authSubtitle { color: %(sub); font-size: 13px; letter-spacing: 0.5px; }
        #authCaption { color: %(sub); font-size: 12px; font-weight: 700; }

        #authEdit { background: %(bgDeep); color: %(text); border: 1px solid %(border);
                    border-radius: 8px; padding: 10px 12px; font-size: 14px; }
        #authEdit:focus { border: 1px solid %(accent); }
        /* 검증 실패한 칸은 테두리를 빨갛게 — 어디가 틀렸는지 바로 보이게 */
        #authEdit[invalid="true"] { border: 1px solid %(critical); }

        #authCheck { color: %(sub); font-size: 12px; }
        #authCheck::indicator { width: 14px; height: 14px; border: 1px solid %(border);
                                border-radius: 3px; background: %(bgDeep); }
        #authCheck::indicator:checked { background: %(accent); border-color: %(accent); }

        /* 위 #authEdit/#authCheck 규칙을 유리 카드 안에서만 덮어쓴다.
         * 불투명 %(bgDeep)를 그대로 두면 반투명 카드 위에 검은 사각형만
         * 도드라져 유리 느낌이 깨진다. 셀렉터가 둘이라 우선순위는 위 규칙보다
         * 높지만, 읽는 사람이 순서로도 알 수 있게 덮어쓸 원본 뒤에 둔다. */
        #authGlassCard #authEdit { background: rgba(9, 13, 18, 0.55);
                                   border: 1px solid rgba(255, 255, 255, 0.14); }
        #authGlassCard #authEdit:focus { background: rgba(9, 13, 18, 0.75);
                                         border: 1px solid %(accent); }
        #authGlassCard #authCheck::indicator { background: rgba(9, 13, 18, 0.55);
                                               border: 1px solid rgba(255, 255, 255, 0.14); }
        #authGlassCard #authCheck::indicator:checked { background: %(accent);
                                                       border-color: %(accent); }

        #authHint { color: %(sub); font-size: 11px; }
        #authHint[invalid="true"] { color: %(critical); font-weight: 600; }
        #authHint[ok="true"] { color: %(normal); font-weight: 600; }
        #authError { color: %(critical); font-size: 12px; font-weight: 600; }

        #authPrimary { background: %(accent); color: %(onAccent); border: none; border-radius: 8px;
                       font-size: 15px; font-weight: 700; letter-spacing: 1px; }
        #authPrimary:hover { background: %(accentHover); }
        #authPrimary:disabled { background: %(border); color: %(sub); }

        /* 링크처럼 보이는 보조 버튼 (회원가입 / 취소) */
        #authLink { background: transparent; color: %(accent); border: none;
                    font-size: 13px; font-weight: 700; padding: 6px; }
        #authLink:hover { color: %(accentHover); text-decoration: underline; }

        #authSep { color: %(border); }
        #authFooter { color: %(sub); font-size: 11px; }
