/* ══════════════════════════════════════════════════════════════════════
   타이포·간격 스케일 규범 (FOUND-07, D-03, D-04)
   QSS에는 CSS 커스텀 프로퍼티가 없어 값을 변수로 선언할 수 없다. 이 블록이
   유일한 출처이며, 신규·수정 규칙은 반드시 여기서만 값을 고른다. 기존에
   이미 박혀 있는 비4px 간격값은 이번 단계 일괄 수정 대상이 아니다 —
   불필요한 회귀 위험만 늘리므로 건드리지 않는다.

   ── 데스크 타이포(50~70cm, 본문·표·명단·로그·폼·라벨 전용) ──
     11px/400  캡션
     12px/600  라벨
     13px/400  본문(전역 기본, 바로 아래 QWidget 규칙)
     17px/800  헤딩(#panelTitle)
   기존 유지 예외(이번 단계에서 되돌리지 않는다):
     19px  다이얼로그 헤더(#dlgName, #camInspCh) — 서브 화면 진입점 강조라 예외
     23px  브랜드 로고(#logo) — 헤더 정체성 요소라 본문 스케일과 무관
     26px  수치 판독용 모노스페이스 데이터 디스플레이(#reportTileVal, #resStatVal)
     32px  수치 판독용 모노스페이스 데이터 디스플레이(#statValue) — 26px과 같은 계열의 상위 단계

   ── 원거리 타이포(2~3m, 아래 경보 계열 objectName에만 적용) ──
     48px/800  경보 배너 헤드라인(#alertBanner)
     32px/800  심각도 배지(#severityBadge)
     24px      상태 인디케이터 최소 지름(#severityDot)
   이 세 값은 경보 계열 밖으로 새어 나가지 않는다(D-03) — 본문·표·명단·폼이
   커지면 정작 경보가 다른 큰 글자들 사이에 묻힌다.
   계산 근거: 실측이 아니라 2.5m 시청거리 · 24인치 1920×1080 · 92PPI 가정 위에서
   "글자높이(in) = 시청거리(ft) / 15" 공식으로 산출한 값이다. Phase 5 리허설
   (VERIFY-04)에서 실물로 재확인하며, 실측값이 들어오면 이 블록과 아래 경보
   계열 세 규칙의 font-size만 고치면 된다 — 값이 파일 곳곳에 흩어져 있지 않다.

   ── 굵기 ──
     400  기본
     700  강조
     800  헤딩·브랜드·경보 전용 예외 — 본문·라벨에 새로 쓰지 않는다

   ── 간격(4px 배수 스케일, D-04: 여유있게 = 간격이 넓다) ──
     4px   아이콘-텍스트 인라인, 배지 내부 패딩 등 미세 간격 전용
     8px   위와 같은 미세 간격 전용
     16px  기본값
     24px  기본값
     32px  기본값
     48px  큰 섹션 분리
     64px  최상위 레이아웃 분리
   4px·8px는 위 용도로만 예약한다 — 기본은 16·24·32다.

   ── 금지 사항(D-05) ──
     보라·파랑 계열 그라데이션 배경 금지 · 카드 안 카드 중첩 금지 · 바운스 효과 금지

   ── accent 용법(Task 1 결과 고정) ──
     accent는 채우기 + %(onAccent) 전경색으로만 쓴다. 텍스트 색으로는 쓰지 않는다.
   ══════════════════════════════════════════════════════════════════════ */

        QWidget { color: %(text); font-family: "Segoe UI", "맑은 고딕", "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans CJK KR", "Noto Sans KR", sans-serif; font-size: 13px; }
        QMainWindow, #centralwidget { background: %(bgDeep); }

        #header { background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                     stop:0 %(panel), stop:1 %(card));
                  border-bottom: 1px solid %(border); }
        #brandDot { background: %(accent); border-radius: 5px; }
        #logo { color: %(text); font-size: 23px; font-weight: 800; letter-spacing: 0.5px; }
        #subtitle { color: %(sub); font-size: 13px; }
        #clock { color: %(text); font-size: 16px; font-weight: 800; letter-spacing: 0.5px;
                 padding: 0 6px; }

        /* 라이트/다크 테마 토글 — 원형 아이콘 버튼 */
        #themeToggle { background: transparent; border: 1px solid %(border); border-radius: 16px;
                       min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px;
                       font-size: 15px; }
        #themeToggle:hover { border-color: %(accent); background: %(card); }

        /* 도움말 버튼 — 원형 물음표 아이콘 + "도움말" 텍스트 (필 형태) */
        #helpBtn { background: transparent; color: %(sub); border: none; border-radius: 15px;
                   padding: 4px 12px 4px 8px; font-size: 13px; font-weight: 600; }
        #helpBtn:hover { background: %(card); color: %(text); }

        /* 도움말 창 — 좌측 주제 목록 */
        #helpList { background: %(card); color: %(sub); border: none; outline: none;
                    border-right: 1px solid %(border); font-size: 13px; }
        #helpList::item { padding: 11px 16px; border: none; }
        #helpList::item:selected { background: %(panel); color: %(text); font-weight: 700;
                                    border-left: 3px solid %(accent); }
        #helpList::item:hover:!selected { color: %(text); }

        /* 도움말 창 — 본문 브라우저. renderHelpTopic()이 매번 다시 그리던
           setStyleSheet 호출을 여기로 옮겼다(정적 규칙, 실시간 값 없음). */
        QTextBrowser#helpBrowser { background: %(panel); border: none; padding: 20px 22px; }

        /* 연결 상태 pill 배지 */
        #statusPill { background: %(card); border: 1px solid %(border); border-radius: 13px; }
        #statusText { color: %(sub); font-size: 12px; font-weight: 600; }

        /* 상태등(statusDot) — ISA-18.2 5단계 severity 동적 속성으로 색을 받는다.
           속성 없는 기본 규칙은 아직 severity가 설정되지 않은 순간과, 아직
           전환되지 않은 다른 statusDot 위젯을 위한 안전망이다.
           주의: C++ 필드명은 warn을 그대로 계승하지만 QSS 속성값은 "medium"이다
           (UI-SPEC §2.1의 의도된 불일치 — %(warn) 참조가 이미 여러 곳에 박혀
           있어 필드명을 바꾸면 치환 실패 위험만 생긴다). */
        #statusDot { background: %(sub); border-radius: 3px; }
        #statusDot[severity="critical"] { background: %(critical); border-radius: 3px; }
        #statusDot[severity="high"] { background: %(high); border-radius: 3px; }
        #statusDot[severity="medium"] { background: %(warn); border-radius: 3px; }
        #statusDot[severity="info"] { background: %(info); border-radius: 3px; }
        #statusDot[severity="normal"] { background: %(normal); border-radius: 3px; }

        /* ── 원거리 경보 계열(2~3m 기준) — Phase 3/4가 위젯에 붙일 objectName 계약.
           이 계획 시점에는 어떤 위젯도 이 이름을 쓰지 않으므로, 화면에 아무
           효과가 없는 것이 정상이다. 다음 사람이 "왜 안 보이지"라고 헤매지
           않도록 이 문단을 남긴다. severity 속성값 어휘는 #statusDot과 동일한
           "critical"|"high"|"medium"|"info"|"normal"이며, C++ 필드명 warn↔QSS
           값 medium 불일치도 동일하게 승계한다. */
        #alertBanner { font-size: 48px; font-weight: 800; color: %(text);
                        padding: 24px 32px; border-radius: 16px;
                        border-left: 8px solid %(sub); background: %(card); }
        #alertBanner[severity="critical"] { border-left-color: %(critical);
            background: %(critical); color: white; }
        #alertBanner[severity="high"] { border-left-color: %(high);
            background: %(high); color: white; }
        #alertBanner[severity="medium"] { border-left-color: %(warn); background: %(card); }
        #alertBanner[severity="info"] { border-left-color: %(info); background: %(card); }
        #alertBanner[severity="normal"] { border-left-color: %(normal); background: %(card); }

        #severityBadge { font-size: 32px; font-weight: 800; color: white;
                          padding: 8px 16px; border-radius: 8px; background: %(sub); }
        #severityBadge[severity="critical"] { background: %(critical); }
        #severityBadge[severity="high"] { background: %(high); }
        #severityBadge[severity="medium"] { background: %(warn); }
        #severityBadge[severity="info"] { background: %(info); }
        #severityBadge[severity="normal"] { background: %(normal); }

        #severityDot { min-width: 24px; min-height: 24px; max-width: 24px; max-height: 24px;
                       border-radius: 12px; background: %(sub); }
        #severityDot[severity="critical"] { background: %(critical); }
        #severityDot[severity="high"] { background: %(high); }
        #severityDot[severity="medium"] { background: %(warn); }
        #severityDot[severity="info"] { background: %(info); }
        #severityDot[severity="normal"] { background: %(normal); }

        /* ══════════════════════════════════════════════════════════════
           심각도를 쓰는 위젯 9종 (02-03 Task1) — objectName 정리 후 신설.
           severity 어휘는 #statusDot과 동일한 "critical"|"high"|"medium"|
           "info"|"normal"이며, C++ 필드명 warn↔QSS 값 medium 불일치도
           동일하게 승계한다(UI-SPEC §2.1). 세터 전환은 02-03 Task2·3.
           ══════════════════════════════════════════════════════════════ */

        /* DB 상태점(9×9) — 헤더 statusDot(7×7, 반지름 3)과 objectName을
           분리한 위젯(정정 B). 반지름이 달라 별도 규칙이 필요하다. */
        #dbStatusDot { background: %(sub); border-radius: 4px; }
        #dbStatusDot[severity="critical"] { background: %(critical); border-radius: 4px; }
        #dbStatusDot[severity="high"] { background: %(high); border-radius: 4px; }
        #dbStatusDot[severity="medium"] { background: %(warn); border-radius: 4px; }
        #dbStatusDot[severity="info"] { background: %(info); border-radius: 4px; }
        #dbStatusDot[severity="normal"] { background: %(normal); border-radius: 4px; }

        /* 바이탈 상태 배지 — 배경은 기존 blendHex() 18% 혼합 대신 평평한
           %(card)로 단순화한다. QSS는 색을 계산하지 못하므로 다섯 개 혼합값을
           새로 정하는 대신 기존 토큰을 그대로 쓴다(차이는 미세하다). */
        #vitalBadge { background: %(card); border: 1px solid %(border); border-radius: 9px;
                      padding: 1px 10px; font-size: 11px; font-weight: 800; color: %(sub); }
        #vitalBadge[severity="critical"] { color: %(critical); border-color: %(critical); }
        #vitalBadge[severity="high"] { color: %(high); border-color: %(high); }
        #vitalBadge[severity="medium"] { color: %(warn); border-color: %(warn); }
        #vitalBadge[severity="info"] { color: %(info); border-color: %(info); }
        #vitalBadge[severity="normal"] { color: %(normal); border-color: %(normal); }

        /* SpO2·심박 값 라벨 — 기존 32px/800 모노스페이스 규칙(아래 #statValue)은
           유지하고 전경색만 severity로 얹는다. */
        #statValue[severity="critical"] { color: %(critical); }
        #statValue[severity="high"] { color: %(high); }
        #statValue[severity="medium"] { color: %(warn); }
        #statValue[severity="info"] { color: %(info); }
        #statValue[severity="normal"] { color: %(normal); }

        /* 입소자 행 위험도 색 띠 — 글자가 없어 도형을 못 붙인다. 이 띠의 색 외
           채널은 같은 행의 위험도 칩(#riskChip) 도형이다 — 이 짝짓기가 깨지지
           않게 한다(D-09 중복 부호화는 행 단위로 성립). */
        #riskBar { background: %(sub); border-radius: 2px; }
        #riskBar[severity="critical"] { background: %(critical); }
        #riskBar[severity="high"] { background: %(high); }
        #riskBar[severity="medium"] { background: %(warn); }
        #riskBar[severity="info"] { background: %(info); }
        #riskBar[severity="normal"] { background: %(normal); }

        /* 위험도 칩(목록 행) — 인라인 값 계승: 1px 9px 패딩, 11px/800, 반지름 9 */
        #riskChip { color: %(sub); border: 1px solid %(sub); border-radius: 9px;
                    padding: 1px 9px; font-size: 11px; font-weight: 800; background: transparent; }
        #riskChip[severity="critical"] { color: %(critical); border-color: %(critical); }
        #riskChip[severity="high"] { color: %(high); border-color: %(high); }
        #riskChip[severity="medium"] { color: %(warn); border-color: %(warn); }
        #riskChip[severity="info"] { color: %(info); border-color: %(info); }
        #riskChip[severity="normal"] { color: %(normal); border-color: %(normal); }

        /* 상세 편집 패널 — 위험도 배지. 인라인 값 계승: 3px 12px 패딩, 12px/800, 반지름 11 */
        #dlgRiskBadge { color: %(sub); border: 1px solid %(sub); border-radius: 11px;
                        padding: 3px 12px; font-size: 12px; font-weight: 800; background: transparent; }
        #dlgRiskBadge[severity="critical"] { color: %(critical); border-color: %(critical); }
        #dlgRiskBadge[severity="high"] { color: %(high); border-color: %(high); }
        #dlgRiskBadge[severity="medium"] { color: %(warn); border-color: %(warn); }
        #dlgRiskBadge[severity="info"] { color: %(info); border-color: %(info); }
        #dlgRiskBadge[severity="normal"] { color: %(normal); border-color: %(normal); }

        /* 상세 편집 패널 — 상태 배지(재원/퇴원). 재원 여부는 등급이 아니라
           분류라 severity 어휘를 쓰지 않는다(02-03 Task3) — 전용 속성
           residency로만 재원 여부를 표시하고 도형은 붙이지 않는다.
           인라인 값 계승: dlgRiskBadge와 같은 크기. */
        #dlgStatusBadge { color: %(sub); border: 1px solid %(sub); border-radius: 11px;
                          padding: 3px 12px; font-size: 12px; font-weight: 800; background: transparent; }
        #dlgStatusBadge[residency="active"] { color: %(normal); border-color: %(normal); }

        /* 알림 노드 온·오프라인 배지 — 카메라 인스펙터 배지(#camPill)와
           objectName 분리(정정 C). 기본 규칙은 #camPill과 동일하게 맞춰
           전환 전(Task1) 시점에 초기 렌더가 갈리지 않게 한다. */
        #alertNodeBadge { color: %(sub); border: 1px solid %(border); border-radius: 9px;
                          padding: 1px 9px; font-size: 11px; font-weight: 800; }
        #alertNodeBadge[severity="critical"] { color: %(critical); border-color: %(critical); }
        #alertNodeBadge[severity="high"] { color: %(high); border-color: %(high); }
        #alertNodeBadge[severity="medium"] { color: %(warn); border-color: %(warn); }
        #alertNodeBadge[severity="info"] { color: %(info); border-color: %(info); }
        #alertNodeBadge[severity="normal"] { color: %(normal); border-color: %(normal); }

        /* 입소자 관리 요약 통계 — 심각도가 아니라 통계 카테고리(FOUND-06:
           재원 카드가 accent를 26px 굵은 텍스트 색으로 쓰던 문제를 여기서
           해소한다. accent는 큰 글씨 기준(3:1)조차 통과하지 못한다). */
        #resStatVal[category="active"] { color: %(text); }
        #resStatVal[category="danger-high"] { color: %(critical); }
        #resStatVal[category="danger-mid"] { color: %(warn); }
        #resStatVal[category="danger-low"] { color: %(normal); }
        #resStatVal[category="channel"] { color: %(text); }

        /* 무신호 상태(대기·신호 끊김·미착용) — severity와 분리된 vital 속성.
           반드시 같은 objectName의 [severity=...] 규칙들보다 파일에서 뒤에
           와야 한다 — QSS는 특이도가 같으면 나중 선언이 이기므로, 순서가
           바뀌면 무신호인데도 이전 심각도 색이 살아남는다. */
        #statValue[vital="stale"] { color: %(sub); }
        #vitalBadge[vital="stale"] { color: %(sub); border-color: %(sub); background: %(card); }

        /* 로그인 사용자 표시 — 아바타+이름+로그아웃을 감싼 캡슐 */
        #userChip { background: %(card); border: 1px solid %(border); border-radius: 19px; }
        #userChip:hover { border-color: %(accent); }
        #userAvatar { background: %(accent); color: %(onAccent); border-radius: 15px;
                      font-size: 13px; font-weight: 800; }
        #userName { color: %(text); font-size: 13px; font-weight: 700; }
        #logoutButton { background: transparent; color: %(sub); border: none;
                        border-radius: 14px; padding: 5px 12px; font-size: 12px; font-weight: 600; }
        #logoutButton:hover { background: %(critical); color: #fff; }

        /* ── 좌측 네비 레일 ── */
        #navRail { background: %(panel); border-right: 1px solid %(border); }
        #navBtn { background: transparent; color: %(sub); border: none; border-radius: 10px;
                  padding: 0 12px; text-align: left;
                  font-size: 13px; font-weight: 700; letter-spacing: 0.2px; }
        #navBtn:hover { background: %(card); color: %(text); }
        #navBtn:checked { background: %(accent); color: %(onAccent); font-weight: 800; }
        /* 접힘 상태 — 라벨이 없으니 아이콘을 가운데로 */
        #navBtn[collapsed="true"] { padding: 0; text-align: center; }
        #navToggle { background: transparent; color: %(sub); border: none;
                     border-radius: 8px; font-size: 15px; }
        #navToggle:hover { background: %(card); color: %(text); }

        #panel { background: %(panel); border: 1px solid %(border); border-radius: 16px; }
        /* 섹션 제목: 좌측 굵은 청록 악센트 바 + 큼직한 타이틀 */
        #panelTitle { color: %(text); font-size: 17px; font-weight: 800; letter-spacing: 0.3px;
                      border-left: 4px solid %(accent); padding: 1px 0 1px 12px; }

        #roiButton, #roiToggle, #roiClear { background: %(card); color: %(text); border: 1px solid %(border);
                                 border-radius: 10px; padding: 7px 15px; font-size: 12px; font-weight: 600; }
        #roiButton:hover, #roiToggle:hover { border-color: %(accent); }
        #roiToggle:checked { background: %(accent); color: %(onAccent); border-color: %(accent); }
        #roiClear:hover { border-color: %(critical); color: %(critical); }

        /* ── 관제화면 ROI 세그먼트 그룹 ── */
        #segGroup { background: %(bgDeep); border: 1px solid %(border); border-radius: 9px; }
        #segCaption { color: %(sub); font-size: 11px; font-weight: 800; letter-spacing: 1px; }
        #segBtn, #segBtnDanger, #segBtnToggle {
            background: transparent; color: %(text); border: none;
            border-radius: 6px; padding: 5px 13px; font-size: 12px; font-weight: 600; }
        #segBtn:hover, #segBtnToggle:hover { background: %(card); }
        #segBtnDanger:hover { background: %(card); color: %(critical); }
        #segBtnToggle:checked { background: %(accent); color: %(onAccent); }

        #micButton { background: %(card); color: %(text); border: 1px solid %(border);
                     border-radius: 10px; padding: 7px 15px; font-size: 12px; font-weight: 600; }
        #micButton:hover { border-color: %(accent); }
        #micButton[active="true"] { color: #fff; border-color: %(critical);
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #ff6b62, stop:1 %(critical)); }

        /* 경보 해제 — 평상시엔 차분한 아웃라인, 경보 활성 시(active=true)에만 빨강 그라데이션 */
        #alarmButton { background: %(card); color: %(sub); border: 1px solid %(border);
                       border-radius: 10px; padding: 7px 15px; font-size: 12px; font-weight: 700; }
        #alarmButton:hover { border-color: %(critical); color: %(critical); }
        #alarmButton[active="true"] { color: #fff; border-color: %(critical); font-weight: 800;
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #ff6b62, stop:1 %(critical)); }
        #alarmButton[active="true"]:hover { background: #ff6b62; }

        /* 경보 토스트 — 상단에서 내려오는 떠 있는 알림 카드 */
        #alarmToast { background: %(card); border: 1px solid %(border);
                      border-left: 4px solid %(critical); border-radius: 12px; }
        #alarmDot { background: %(critical); border-radius: 4px; }
        #alarmToastText { color: %(text); font-size: 14px; font-weight: 800; letter-spacing: 0.2px; }
        #alarmToastBtn { background: %(critical); color: #fff; border: none; border-radius: 8px;
                         padding: 7px 16px; font-size: 13px; font-weight: 800; }
        #alarmToastBtn:hover { background: #ff6b62; }

        /* NVR 매트릭스: 순수 검정 셀 + 얇은 구분선. 정보는 VideoView가 영상 위에 오버레이.
           배경은 팔레트가 아니라 영상 캔버스 전용 단일 출처 토큰을 참조한다(D-07/IA-02) —
           videoview.cpp의 paintEvent()가 같은 상수(kVideoSurface)로 칠하는 영역과
           반드시 같은 검정이어야 카드 테두리 안쪽과 실제 영상 영역의 색이 갈리지 않는다. */
        #videoCard { background: %(videoSurface); border: 1px solid %(border); border-radius: 12px; }

        /* ═══ Wisenet Viewer 스타일 관제 화면 ═══
           select 토큰은 "여러 개 중 지금 고른 하나"에만 쓴다(선택 타일 테두리,
           활성 레이아웃 탭, 트리 선택 행). accent(청록)는 그대로 "주요 동작"
           전용 — 둘을 섞으면 누를 것과 고른 것이 구분되지 않는다. */

        /* 좌측 리소스 패널 */
        #resourcePanel { background: %(panel); border: 1px solid %(border); border-radius: 12px; }
        #resourceHead { color: %(sub); font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
        #resourceToggle { background: transparent; color: %(sub); border: 1px solid %(border);
                          border-radius: 4px; font-size: 12px; font-weight: 700; }
        #resourceToggle:hover { border-color: %(select); color: %(text); }
        #resourceSearch { background: %(card); color: %(text); border: 1px solid %(border);
                          border-radius: 4px; padding: 5px 8px; font-size: 12px; }
        #resourceSearch:focus { border-color: %(select); }
        #resourceTree { background: transparent; border: none; outline: none; font-size: 12px; }
        #resourceTree::item { padding: 4px 2px; border: none; border-radius: 3px; }
        #resourceTree::item:hover { background: %(card); }
        #resourceTree::item:selected { background: %(select); color: %(onSelect); }

        /* 레이아웃 프리셋 탭 (그리드 위) */
        #layoutTabBar { background: transparent; border: none; }
        #layoutTab { background: transparent; color: %(sub); border: 1px solid %(border);
                     border-radius: 3px; padding: 4px 12px; font-size: 12px; font-weight: 600; }
        #layoutTab:hover { color: %(text); border-color: %(select); }
        #layoutTab:checked { background: %(select); color: %(onSelect); border-color: %(select); }
        #layoutRestoreBtn { background: transparent; color: %(sub); border: 1px solid %(border);
                            border-radius: 3px; padding: 4px 10px; font-size: 12px; }
        #layoutRestoreBtn:hover { color: %(text); border-color: %(select); }

        /* 관제 그리드 타일 — 각진 모서리 + 선택 시 select 테두리.
           #videoCard(NVR 탐색·블랙박스 카드)와 일부러 이름을 분리했다. */
        #gridHost { background: transparent; }
        /* 비선택 타일도 테두리를 2px로 잡되 투명하게 둔다 — 선택 시 두께가 바뀌면
           영상 영역이 1px 흔들린다. 화면에는 검은 타일만 보인다(Wisenet과 동일). */
        #videoTile { background: %(videoSurface); border: 2px solid transparent;
                     border-radius: 0; }
        #videoTile[selected="true"] { border: 2px solid %(select); }

        /* 타일 크롬 — 닫기 버튼 / 호버 툴바 */
        #tileClose { background: rgba(0, 0, 0, 150); color: #E6EDF3; border: none;
                     border-radius: 3px; font-size: 11px; font-weight: 700; }
        #tileClose:hover { background: %(critical); color: #FFFFFF; }
        #tileToolbar { background: rgba(0, 0, 0, 170); border: 1px solid rgba(255, 255, 255, 40);
                       border-radius: 4px; }
        #tileToolBtn { background: transparent; color: #E6EDF3; border: none;
                       border-radius: 3px; font-size: 13px; }
        #tileToolBtn:hover { background: %(select); color: %(onSelect); }

        /* 하단 트랜스포트 바 */
        #transportBar { background: %(card); border: 1px solid %(border);
                        border-bottom: none; border-top-left-radius: 4px;
                        border-top-right-radius: 4px; }
        #transportBtn { background: transparent; color: %(text); border: none;
                        border-radius: 3px; font-size: 13px; }
        #transportBtn:hover { background: %(panel); color: %(select); }
        #transportTime { color: %(sub); font-size: 12px; font-weight: 600;
                         padding-left: 8px; }
        #transportSpeed { background: %(panel); color: %(text); border: 1px solid %(border);
                          border-radius: 3px; padding: 3px 8px; font-size: 12px; min-width: 52px; }
        #transportSpeed::drop-down { border: none; width: 16px; }
        #modeBtn { background: transparent; color: %(sub); border: 1px solid %(border);
                   border-radius: 3px; padding: 4px 12px; font-size: 12px; font-weight: 600; }
        #modeBtn:hover { color: %(text); border-color: %(select); }
        #modeBtn:checked { background: %(select); color: %(onSelect); border-color: %(select); }

        /* 재생 화면 — 라이브 그리드와 같은 검은 바탕을 쓴다 */
        #playbackVideo { background: %(videoSurface); }
        #playbackHint { background: %(videoSurface); color: %(sub); font-size: 13px;
                        line-height: 20px; }

        #video { color: #9AA7B2; font-size: 13px; background: %(videoSurface); border-radius: 12px; }

        #vitalScroll { background: transparent; }
        #vitalScroll > QWidget > QWidget { background: transparent; }
        #vitalCard { background: %(card); border: 1px solid %(border); border-radius: 14px; }
        #vitalHead { background: %(panel); border-bottom: 1px solid %(border);
                     border-top-left-radius: 14px; border-top-right-radius: 14px; }
        #vitalName { color: %(text); font-size: 14px; font-weight: 800; }
        #vitalBed { color: %(sub); font-size: 12px; }
        #statBox { background: %(bgDeep); border: 1px solid %(border); border-radius: 12px; }
        #statCaption { color: %(sub); font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
        #statValue { font-family: "Consolas", "D2Coding", "Menlo", "DejaVu Sans Mono", monospace;
                     font-size: 32px; font-weight: 800; }
        #statUnit { color: %(sub); font-size: 12px; font-weight: 600; padding-bottom: 5px; }
        #vitalUpdated { color: %(sub); font-size: 11px; }

        /* ── 카드형 위젯 공통 스타일(일일 리포트 달력/지표 카드가 사용) ── */
        #careCard { background: %(card); border: 1px solid %(border); border-radius: 16px; }
        #careMeta { color: %(sub); font-size: 12px; }
        #careBigCap { color: %(sub); font-size: 12px; font-weight: 600; }
        #careMiniCap { color: %(sub); font-size: 11px; font-weight: 600; }

        /* ── 일일 리포트 ──
           QCalendarWidget은 내부가 네비게이션바 + QTableView로 되어 있어서
           위젯 하나에 색을 줘도 안쪽이 기본 흰색으로 남는다. 다크에서 이 부분만
           하얗게 튀므로 내부 위젯을 이름으로 하나씩 눌러준다. */
        #reportDate { color: %(text); font-size: 16px; font-weight: 800; }
        #reportCalendar { background: %(card); border: none; }
        #reportCalendar QWidget#qt_calendar_navigationbar {
            background: %(card); border-bottom: 1px solid %(border); }
        /* ★ 달력 안쪽 글자 크기는 px 가 아니라 pt 로 준다.
           QFont 은 크기를 pt 나 px 중 하나로만 갖는데, px 로 정하면 pointSize()
           가 -1("pt 로 정해지지 않음")을 돌려준다. QCalendarWidget 은 날짜 칸을
           그릴 때 본문 폰트에서 pointSize 를 꺼내 계산하므로, 앱 전역의
           QWidget{font-size:13px} 를 그대로 물려받으면 그 -1 을 다시
           setPointSize 에 넣어 'Point size <= 0' 경고가 뜬다.
           동작에는 지장이 없지만 날짜를 누를 때마다 콘솔이 더러워진다.
           ※ 이 스타일시트 전체가 raw 문자열이라, 주석 안에서도 닫는 괄호
             바로 뒤에 큰따옴표가 오면 문자열이 그 자리에서 끊긴다. 금지. */
        #reportCalendar, #reportCalendar QAbstractItemView { font-size: 10pt; }
        #reportCalendar QToolButton {
            background: transparent; color: %(text); border: none;
            font-size: 10pt; font-weight: 700; padding: 4px 8px; }
        #reportCalendar QToolButton:hover { background: %(panel); border-radius: 6px; }
        #reportCalendar QToolButton::menu-indicator { image: none; }
        #reportCalendar QAbstractItemView:enabled {
            background: %(card); color: %(text); outline: none;
            selection-background-color: %(accent); selection-color: %(onAccent); }
        /* 이번 달 밖의 날짜 + 미래 날짜(선택 불가) */
        #reportCalendar QAbstractItemView:disabled { color: %(border); }
        #reportCalendar QTableView QHeaderView::section {
            background: %(card); color: %(sub); border: none;
            font-size: 8pt; font-weight: 700; padding: 4px 0; }
        #reportTodayBtn { background: transparent; color: %(text);
                          border: 1px solid %(accent); border-radius: 8px;
                          padding: 6px 0; font-size: 12px; font-weight: 700; }
        #reportTodayBtn:hover { border-color: %(accent); background: %(panel); }
        /* 입소자 이름 탭 — 선택된 하나만 강조색으로 채운다 */
        #residentTab { background: transparent; color: %(sub);
                       border: 1px solid %(border); border-radius: 14px;
                       padding: 5px 14px; font-size: 13px; font-weight: 700; }
        #residentTab:hover { color: %(text); border-color: %(sub); }
        #residentTab:checked { background: %(accent); color: %(onAccent); border-color: %(accent); }
        /* 지표 타일 */
        #reportTile { background: %(panel); border: 1px solid %(border); border-radius: 12px; }
        #reportTileVal { color: %(text); font-family: "Consolas", "D2Coding", "Menlo", "DejaVu Sans Mono", monospace;
                         font-size: 26px; font-weight: 800; }

        /* 스크롤바 — 세로/가로 모두 다크. 트랙(page)·코너의 기본 흰색을 없앤다 */
        QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
        QScrollBar::handle:vertical { background: %(border); border-radius: 5px; min-height: 30px; }
        QScrollBar::handle:vertical:hover { background: %(sub); }
        QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
        QScrollBar::handle:horizontal { background: %(border); border-radius: 5px; min-width: 30px; }
        QScrollBar::handle:horizontal:hover { background: %(sub); }
        QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: transparent; }
        QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
        QAbstractScrollArea::corner { background: transparent; }

        /* ── 이벤트 기록 ── */
        #filterBar QLabel { color: %(sub); font-size: 12px; }
        #filterBar QComboBox, #filterBar QDateEdit {
            background: %(card); color: %(text); border: 1px solid %(border);
            border-radius: 8px; padding: 5px 10px; }
        #logTable { background: %(panel); color: %(text); gridline-color: transparent;
                    border: 1px solid %(border); border-radius: 12px;
                    alternate-background-color: %(card); }
        #logTable::item { padding: 4px 8px; border: none; }
        #logTable QHeaderView::section { background: %(bgDeep); color: %(sub);
                                         border: none; border-bottom: 1px solid %(border);
                                         padding: 9px 8px; font-weight: 700; }
        #logTable::item:selected { background: %(accent); color: %(onAccent); }

        /* NVR(연속녹화) 탐색 — QComboBox/QListWidget은 objectName 없이 두면
           플랫폼 기본 팔레트(대개 흰 배경)로 그려져 다크 테마에서 튄다.
           #logTable/#filterBar QComboBox와 같은 원리로 이름 붙여 명시적으로 칠한다. */
        #nvrChannelCombo { background: %(card); color: %(text); border: 1px solid %(border);
                           border-radius: 8px; padding: 5px 10px; }
        #nvrChannelCombo QAbstractItemView { background: %(card); color: %(text);
                                             outline: none;
                                             selection-background-color: %(accent);
                                             selection-color: %(onAccent); }
        #nvrRefreshBtn, #nvrJumpButton, #clipDownloadButton {
            background: %(card); color: %(text); border: 1px solid %(border);
            border-radius: 8px; padding: 5px 12px; font-weight: 700; }
        #nvrRefreshBtn:hover, #nvrJumpButton:hover, #clipDownloadButton:hover { border-color: %(accent); }
        #nvrJumpButton:disabled, #clipDownloadButton:disabled { color: %(sub); border-color: %(border); }
        #nvrSegmentList { background: %(panel); color: %(text); border: 1px solid %(border);
                          border-radius: 12px; outline: none; }
        #nvrSegmentList::item { padding: 6px 10px; border: none; }
        #nvrSegmentList::item:selected { background: %(accent); color: %(onAccent); }

        /* 영상검색(🔍) — NVR 탐색과 같은 이유로 objectName마다 명시적으로 칠한다. */
        #searchChannelCombo { background: %(card); color: %(text); border: 1px solid %(border);
                              border-radius: 8px; padding: 5px 10px; }
        #searchChannelCombo QAbstractItemView { background: %(card); color: %(text);
                                                outline: none;
                                                selection-background-color: %(accent);
                                                selection-color: %(onAccent); }
        #searchQueryEdit { background: %(card); color: %(text); border: 1px solid %(border);
                           border-radius: 8px; padding: 5px 10px; }
        #searchQueryEdit:focus { border-color: %(accent); }
        #searchButton {
            background: %(card); color: %(text); border: 1px solid %(border);
            border-radius: 8px; padding: 5px 14px; font-weight: 700; }
        #searchButton:hover { border-color: %(accent); }
        #searchButton:disabled { color: %(sub); border-color: %(border); }
        #searchResultBrowser { background: %(panel); color: %(text); border: 1px solid %(border);
                               border-radius: 12px; padding: 6px 10px; }
        #searchResultBrowser a { color: %(accent); }

/* ── TAB3: DB 관리 ── */

QLabel {
    color: %(text);
}

/* 검색창 */
#searchEdit { background: %(card); color: %(text); border: 1px solid %(border);
              border-radius: 17px; padding: 4px 14px; font-size: 13px; }
#searchEdit:focus { border-color: %(accent); }

/* 주요 액션 버튼(신규 등록·저장) */
#primaryButton { background: %(accent); color: %(onAccent); border: none;
                 border-radius: 8px; padding: 6px 18px; font-size: 13px; font-weight: 700; }
#primaryButton:hover { background: %(accent); opacity: 0.9; }
#dangerButton { background: transparent; color: %(critical); border: 1px solid %(critical);
                border-radius: 8px; padding: 6px 16px; font-size: 13px; font-weight: 700; }
#dangerButton:hover { background: %(critical); color: #fff; }
#iconButton { background: %(card); color: %(text); border: 1px solid %(border);
              border-radius: 8px; font-size: 16px; font-weight: 700; }
#iconButton:hover { border-color: %(accent); color: %(text); background: %(bgDeep); }

/* ── 입소자 관리: 상단 요약 통계 ── */
#resStat { background: %(card); border: 1px solid %(border); border-radius: 14px; }
/* 큰 숫자가 세로로 잘리지 않도록 라벨에 충분한 높이를 준다 */
#resStatVal { font-family: "Consolas", "D2Coding", "Menlo", "DejaVu Sans Mono", monospace;
              font-size: 26px; font-weight: 800; min-height: 34px; padding: 0; }
#resStatCap { color: %(sub); font-size: 12px; font-weight: 700; }

/* ── 입소자 관리: 좌측 목록(마스터) ── */
#listPanel { background: %(card); border: 1px solid %(border); border-radius: 14px; }
#cardHost { background: transparent; }

/* 재원/전체/퇴원 세그먼트 탭 */
#segTab { background: %(bgDeep); color: %(sub); border: 1px solid %(border);
          padding: 6px 0; font-size: 12px; font-weight: 700; }
#segTab:hover { color: %(text); }
#segTab:checked { background: %(accent); color: %(onAccent); border-color: %(accent); }

/* 목록 행 카드 */
#resRow { background: %(bgDeep); border: 1px solid %(border); border-radius: 12px;
          text-align: left; }
#resRow:hover { border-color: %(accent); }
#resRow[selected="true"] { border: 2px solid %(accent); background: %(panel); }
#resRow[inactive="true"] { background: transparent; }
#resName { color: %(text); font-size: 15px; font-weight: 800; }
#resMeta { color: %(sub); font-size: 12px; }

/* 아바타(목록 행/상세 편집 패널) — active 속성(재원 여부)으로 배경·전경이 갈린다.
   심각도가 아니므로 severity 어휘를 쓰지 않는다.
   비활성 배경에 보조 텍스트색(%(sub))을 쓰지 않는다 — 라이트는 %(sub)가 중간 톤,
   다크는 밝은 톤이라 두 팔레트가 정반대 전경색을 요구하게 되어 한쪽이 반드시
   AA를 어긴다. 테두리색 배경 + 본문색 전경은 두 팔레트 모두 같은 방향(라이트:
   밝은 배경+어두운 글씨 / 다크: 어두운 배경+밝은 글씨)으로 움직여 10:1대를 유지한다.
   이 두 규칙을 한 줄로 묶지 말 것 — active/inactive는 서로 다른 전경색이 필요하다. */
#resAvatar { border-radius: 19px; font-size: 16px; font-weight: 800; }
#resAvatar[active="true"] { background: %(accent); color: %(onAccent); }
#resAvatar[active="false"] { background: %(border); color: %(text); }
#dlgAvatar { border-radius: 26px; font-size: 22px; font-weight: 800; }
#dlgAvatar[active="true"] { background: %(accent); color: %(onAccent); }
#dlgAvatar[active="false"] { background: %(border); color: %(text); }

/* ── 입소자 관리: 우측 디테일(인라인 편집) ── */
#detailPanel { background: %(card); border: 1px solid %(border); border-radius: 14px; }
#detailPlaceholder { color: %(sub); font-size: 14px; }

/* ── 카메라 설정: [채널 스트립] │ [스테이지] │ [인스펙터] 3단 워크스페이스 ── */
#camStrip { background: %(card); border: 1px solid %(border); border-radius: 16px; }
#camRailCap { color: %(sub); font-size: 11px; font-weight: 800; letter-spacing: 2px;
              padding-left: 2px; }
/* 채널 타일 — 썸네일을 품은 체크 버튼. 선택은 '테두리 + 바탕'으로만 표시해서
   썸네일(진짜 정보)이 색에 묻히지 않게 한다. */
#camTile { background: transparent; border: 2px solid transparent;
           border-radius: 12px; padding: 0; text-align: left; }
#camTile:hover { background: %(bgDeep); border-color: %(border); }
#camTile:checked { background: %(bgDeep); border-color: %(accent); }
#camTileCh { color: %(text); font-size: 12px; font-weight: 800; letter-spacing: 0.5px; }
/* connected 속성 — 심각도가 아니라 연결 여부다. 텍스트의 ●/○ 접두(ALERT-02)와
   함께 같은 갱신 경로에서 설정돼야 색과 모양이 어긋나지 않는다. */
#camChStatus { font-size: 11px; font-weight: 700; }
#camChStatus[connected="true"] { color: %(normal); }
#camChStatus[connected="false"] { color: %(sub); }

#camControlPanel { background: %(card); border: 1px solid %(border); border-radius: 16px; }
#camInspCh { color: %(text); font-size: 19px; font-weight: 800; letter-spacing: 0.5px; }
#camPill { color: %(sub); border: 1px solid %(border); border-radius: 9px;
           padding: 1px 9px; font-size: 11px; font-weight: 800; }
#camPill[connected="true"] { color: %(normal); border: 1px solid %(normal); }
#camPill[connected="false"] { color: %(sub); border: 1px solid %(sub); }
#camInspIp { color: %(sub); font-size: 11px; font-family: "Consolas", "D2Coding", "Menlo", "DejaVu Sans Mono", monospace; }
#camRule { background: %(border); }

/* 연결·ROI·이미지 세그먼트 — 트랙(#camSeg) 안에 얹힌 알약 버튼 */
#camSeg { background: %(bgDeep); border: 1px solid %(border); border-radius: 12px; }
#camSegBtn { background: transparent; color: %(sub); border: none; border-radius: 9px;
             padding: 9px 0; font-size: 13px; font-weight: 700; }
#camSegBtn:hover { color: %(text); }
#camSegBtn:checked { background: %(accent); color: %(onAccent); font-weight: 800; }

#camSectionCap { color: %(text); font-size: 12px; font-weight: 800; letter-spacing: 0.5px;
                 border-left: 3px solid %(accent); padding-left: 8px; }
#camHint { color: %(sub); font-size: 12px; }
/* 그 페이지의 주 액션(연결/적용) — 채워진 악센트 */
#camPrimary { background: %(accent); color: %(onAccent); border: 1px solid %(accent);
              border-radius: 10px; padding: 8px 16px; font-size: 12px; font-weight: 800; }
#camPrimary:hover { background: %(accentHover); border-color: %(accentHover); }
/* 우측 영상 스테이지 — 영상은 VideoView/FramePreview가 직접 둥글게 그린다.
   배경은 영상 캔버스 전용 단일 출처 토큰을 참조한다(D-07/IA-02) —
   FramePreview::paintEvent()의 kVideoSurface와 같은 검정이어야 한다. */
#camStage { background: %(videoSurface); border: 1px solid %(border); border-radius: 14px; }
#camStageCap { color: %(sub); font-size: 11px; font-weight: 800; letter-spacing: 1px; }

/* ROI 페이지 — 단계 카드 + 주 액션 */
#roiSteps { background: %(bgDeep); border: 1px solid %(border); border-radius: 12px; }
#roiStepNum { background: %(accent); color: %(onAccent); border-radius: 11px;
              font-size: 12px; font-weight: 800; }
#roiStepText { color: %(text); font-size: 13px; }
#roiPrimary { background: %(accent); color: %(onAccent); border: none; border-radius: 10px;
              font-size: 14px; font-weight: 800; }
#roiPrimary:hover { background: %(accentHover); }
#roiPrimary[drawing="true"] { background: %(critical); }
#roiPrimary[drawing="true"]:hover { background: #ff6b62; }

/* 인스펙터 침대 목록 행 — 영상에서 고른 침대를 선택 강조로 알아볼 수 있게 한다.
   %(card)는 라이트·다크 두 팔레트 모두에서 주변 표면과 구분되는 톤이라
   어두운 배경을 전제한 반투명 흰색과 달리 라이트 테마에서도 보인다. */
#roiBedRow { background: transparent; border-radius: 6px; }
#roiBedRow[selected="true"] { background: %(card); }

/* 편집기 프로필 헤더 */
#dlgHeader { background: %(panel); border: 1px solid %(border); border-radius: 12px; }
#dlgName { color: %(text); font-size: 19px; font-weight: 800; }
#dlgSub  { color: %(sub); font-size: 13px; }

QGroupBox#formGroup {
    color: %(text);
    border: 1px solid %(border);
    border-radius: 8px;
    margin-top: 10px;
    padding: 14px 10px 10px 10px;
    font-weight: 700;
}

QGroupBox#formGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: %(text);
    background: %(card);
}

QGroupBox#formGroup QLabel {
    color: %(text);
    font-weight: 600;
    font-size: 13px;
    min-width: 90px;
}

QLineEdit#formEdit,
QTextEdit#formEdit,
QComboBox#formEdit,
QDateEdit#formEdit {
    background: %(panel);
    color: %(text);
    border: 1px solid %(border);
    border-radius: 6px;
    padding: 4px 8px;
}

QLineEdit#formEdit:focus,
QTextEdit#formEdit:focus {
    border-color: %(accent);
}

        QComboBox#formEdit QAbstractItemView {
            background: %(bgDeep); color: %(text);
            border: 1px solid %(border);
            selection-background-color: %(accent); selection-color: %(onAccent); }
        QComboBox#formEdit::drop-down { border: none; width: 20px; }
        QComboBox#formEdit::down-arrow { image: none; width: 0; height: 0;
            border-left: 4px solid transparent; border-right: 4px solid transparent;
            border-top: 5px solid %(sub); margin-right: 8px; }

        /* 케어 로그 필터바 콤보 팝업 — 닫힘 상태는 390-392행이 이미 담당한다. 콤보 팝업은
           Qt 내부적으로 별도 top-level 위젯이라 부모 규칙이 자동 상속되지 않으므로 펼침 목록만 따로 잡는다. */
        #filterBar QComboBox QAbstractItemView {
            background: %(card); color: %(text);
            border: 1px solid %(border);
            outline: none;
            selection-background-color: %(accent); selection-color: %(onAccent); }


        /* ── 캘린더 팝업 (QDateEdit) ── */
        QCalendarWidget QWidget { background: %(panel); color: %(text); }
        QCalendarWidget QAbstractItemView {
            background: %(bgDeep); color: %(text);
            selection-background-color: %(accent); selection-color: %(onAccent);
            outline: none; }
        QCalendarWidget QWidget#qt_calendar_navigationbar {
            background: %(card); border-bottom: 1px solid %(border); }
        QCalendarWidget QToolButton {
            background: transparent; color: %(text); border: none; padding: 4px 8px; }
        QCalendarWidget QToolButton:hover { background: %(border); border-radius: 4px; }
        QCalendarWidget QSpinBox {
            background: %(bgDeep); color: %(text); border: 1px solid %(border); }
        QCalendarWidget QAbstractItemView:disabled { color: %(sub); }

        /* ── 공용 다이얼로그·메시지박스·메뉴 ──
           기본 스타일이 흰 배경으로 떠서 밝은 글씨가 안 보이는 것 방지 */
        QMessageBox, QInputDialog, QDialog { background: %(panel); }
        QMessageBox QLabel, QInputDialog QLabel { color: %(text); }
        QMessageBox QPushButton, QInputDialog QPushButton {
            background: %(card); color: %(text); border: 1px solid %(border);
            border-radius: 6px; padding: 5px 16px; font-size: 12px; font-weight: 600;
            min-width: 60px; }
        QMessageBox QPushButton:hover, QInputDialog QPushButton:hover { border-color: %(accent); }
        QMessageBox QPushButton:default, QInputDialog QPushButton:default {
            background: %(accent); color: %(onAccent); border-color: %(accent); }
        QMenu { background: %(panel); color: %(text); border: 1px solid %(border); }
        QMenu::item:selected { background: %(accent); color: %(onAccent); }
        QToolTip { background: %(card); color: %(text); border: 1px solid %(border); }
