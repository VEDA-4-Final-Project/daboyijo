# 카메라 RTSP 채널 설정
# 사용법: 이 파일을 cameras.conf로 복사한 뒤 실제 IP/계정으로 수정 (cameras.conf는 gitignore됨)
#   cp cameras.conf.example cameras.conf
#
# 형식: 채널번호=RTSP URL
#
# PNM-C16083RVQ (멀티디렉셔널 4센서) 확인된 URL 형식:
#   rtsp://<계정>:<비밀번호>@<IP>:554/<채널 0~3>/profile<N>/media.smp
# - profile2 = H.264 2592x1520 @30fps (기본 프로파일, 4채널 동시 디코딩엔 무거움)
# - RPi 배포 시에는 웹 UI(설정>기본>비디오 프로파일)에서 채널별로
#   H.264 / 1280x720 이하 / 10~15fps 서브 프로파일을 만들어 그 번호를 사용할 것

# Qt 클라이언트 영상 송출 포트 (생략 시 5500)
stream_port=5500

# 보호자 알림 (텔레그램) — 봇 토큰이 없거나 채널에 쓸 chat_id가 없으면 그 채널 알림은 비활성
# 1. @BotFather에게 /newbot → 발급받은 토큰을 telegram_bot_token에 (봇은 서버 전체에 하나)
# 2. 알림 받을 사람이 그 봇과 대화 시작(/start) → 아래로 chat_id 확인
#    https://api.telegram.org/bot<토큰>/getUpdates 응답의 message.chat.id
# 3. 채널별로 다른 보호자에게 보내려면 telegram_chat_id_<채널번호> 사용.
#    지정 안 한 채널은 telegram_chat_id(기본값)로 감.
telegram_bot_token=
telegram_chat_id=
telegram_chat_id_0=
telegram_chat_id_1=

0=rtsp://admin:비밀번호@172.20.35.140:554/0/profile2/media.smp
1=rtsp://admin:비밀번호@172.20.35.140:554/1/profile2/media.smp
2=rtsp://admin:비밀번호@172.20.35.140:554/2/profile2/media.smp
3=rtsp://admin:비밀번호@172.20.35.140:554/3/profile2/media.smp
