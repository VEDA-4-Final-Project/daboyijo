# 카메라 RTSP 채널 설정
# 사용법: 이 파일을 cameras.conf로 복사한 뒤 실제 IP/계정으로 수정 (cameras.conf는 gitignore됨)
#   cp cameras.conf.example cameras.conf
#
# 형식: 채널번호=RTSP URL
#
# ★ 이 파일은 "이 서버(Pi)가 담당할 채널"을 선언한다. URL은 선택이다:
#   - URL을 적으면    → 부팅 즉시 그 RTSP로 연결 (기존 방식, 개발·자동기동용)
#   - URL을 비우면("0=") → 채널 슬롯만 만들고 대기. Qt 관제 화면의 "카메라 연결"에서
#                          CCTV IP를 입력하면 그때 서버가 RTSP를 연다 (런타임 지정).
#   2-Pi 분할: Pi A는 아래처럼 0,1만 / Pi B는 2,3만 선언한다.
#
# PNM-C16083RVQ (멀티디렉셔널 4센서) 확인된 URL 형식:
#   rtsp://<계정>:<비밀번호>@<IP>:554/<채널 0~3>/profile<N>/media.smp
# - profile2 = H.264 2592x1520 @30fps (기본 프로파일, 4채널 동시 디코딩엔 무거움)
# - RPi 배포 시에는 웹 UI(설정>기본>비디오 프로파일)에서 채널별로
#   H.264 / 1280x720 이하 / 10~15fps 서브 프로파일을 만들어 그 번호를 사용할 것
# - Qt에서 런타임 지정 시엔 Qt가 이 URL 형식을 그대로 만들어 채널마다 보낸다.

# Qt 클라이언트 영상 송출 포트 (생략 시 5500)
stream_port=5500

# 영상 스트림 TLS. 둘 다 비우면 평문(기존 동작). 인증서는
# MQTT/scripts/generate_stream_certs.sh 로 발급(기존 DavoCA 재사용) — Pi A는
# streamA.crt/key, Pi B는 streamB.crt/key. Qt 쪽은 certs/ca.crt(MQTT용과 동일
# 파일) 유무로 TLS 여부를 스스로 판단하므로 클라이언트 설정은 따로 안 건드려도 됨.
# 경로 하나만 있고 나머지가 비어 있으면(설정 실수) 서버가 시작하지 않는다.
#stream_cert_path=config/streamA.crt
#stream_key_path=config/streamA.key

# [영상검색] 케어봇 "🔍 영상 검색" 결과에 넣을 클립 링크용, 이 Pi 자신의 IP.
# 서버는 자기 IP를 스스로 모른다 — Qt가 붙는 주소(kDefaultHostA/B)와 같은 값.
# 미설정 시 링크 대신 "관제 화면에서 확인" 문구로 대체(기능은 그대로 동작).
#public_host=172.20.32.51

# 보호자 알림 (텔레그램) — 봇 토큰이 없거나 채널에 쓸 chat_id가 없으면 그 채널 알림은 비활성
# 1. @BotFather에게 /newbot → 발급받은 토큰을 telegram_bot_token에 (봇은 서버 전체에 하나)
# 2. 알림 받을 사람이 그 봇과 대화 시작(/start) → 아래로 chat_id 확인
#    https://api.telegram.org/bot<토큰>/getUpdates 응답의 message.chat.id
# 3. 채널별로 다른 보호자에게 보내려면 telegram_chat_id_<채널번호> 사용.
#    지정 안 한 채널은 telegram_chat_id(기본값)로 감.
#    ※ 케어봇(양방향)은 이 chat_id로 "누가 어느 방 보호자인지"를 인증·매핑한다.
#      질문에 방별 상황을 답하려면 반드시 telegram_chat_id_<채널>로 지정해야 한다
#      (기본 telegram_chat_id만 있으면 방을 특정 못 해 안내만 나감).
telegram_bot_token=

# ── 수신자 역할: 보호자(Guardian) / 요양사(Staff) ────────────────────────
# 봇은 하나만 쓰고, 누가 무엇을 받는지는 아래 키로 갈린다.
#
#  telegram_chat_id_<채널>              그 방을 조회할 수 있는 보호자들(콤마로 여럿)
#  telegram_guardian_chat_id_<입소자id> 그 입소자 사고를 받을 보호자 1명
#  telegram_staff_chat_id               요양사(전 채널 담당). 콤마로 여럿
#  telegram_chat_id                     채널 지정이 하나도 없을 때의 기본 수신자
#
# 낙상처럼 사람이 특정되는 사건은 입소자 매핑을 먼저 쓴다. 신원 미상이면 그 방
# 보호자 전원으로 폴백한다 — 방에 두 분이 계신데 매핑이 없을 때 "둘 다에게"가
# "엉뚱한 한 명에게만"보다 낫기 때문.
#
# 역할별로 이렇게 다르다:
#  · 보호자 — 자기 방만 보이고, 🔕 오늘 알림 끄기 버튼이 있다(침상 이탈에만 적용).
#  · 요양사 — 전 채널. 먼저 방을 고르고 들어간다. 무음 버튼이 없다(근무 중 알림을
#             끄는 경로를 두지 않는다). 낙상·생체이상은 양쪽 다 항상 받는다.
#
# ── 시연 예시: 1번 방에 어르신 두 분, 보호자 2 + 요양사 2 ──────────────
#   telegram_chat_id_0=111111111,222222222       # 1번 방을 볼 수 있는 보호자 둘
#   telegram_guardian_chat_id_1=111111111        # 입소자1(김○○)의 보호자
#   telegram_guardian_chat_id_2=222222222        # 입소자2(이○○)의 보호자
#   telegram_staff_chat_id=333333333,444444444   # 요양사 둘 — 전 채널
# 이러면 침대1 김○○ 낙상 시 111111111 + 요양사 둘에게만 가고, 222222222 에게는
# 가지 않는다. 입소자 id 는 residents 테이블의 resident_id 값이다.
#
# ※ 입소자 매핑을 안 쓰고 방 단위로만 굴려도 동작한다(그 방 보호자 전원에게 발송).
telegram_chat_id=
telegram_chat_id_0=
telegram_chat_id_1=
telegram_guardian_chat_id_1=
telegram_staff_chat_id=

# 보호자에게 사건 알림(낙상·이탈·생체이상)을 보낼지. 0이면 보호자는 봇으로 조회만
# 하고 알림은 받지 않는다(요양사 알림은 이 값과 무관하게 항상 나간다).
# 미지정 시 1 = 기존처럼 보호자도 알림을 받는다.
telegram_guardian_alerts=1

# 케어봇 실시간 상황 질의응답용 VLM (Google Gemini)
# - Google AI Studio(https://aistudio.google.com/apikey)에서 API 키 발급 → gemini_api_key
# - gemini_model: 미지정 시 gemini-3.6-flash. 별칭(gemini-flash-latest)은 쓰지 말 것 —
#   가리키는 모델이 바뀌면 오류 없이 응답만 안 오는 상태로 조용히 멈춘다(2026-08 실측).
#   모델을 바꿀 땐 tools/gemini_probe.sh 로 실제 응답이 오는지 먼저 확인할 것.
# - 미설정이면 봇은 질문에 "설정 필요" 안내만 하고 서버는 정상 동작.
gemini_api_key=
gemini_model=

# 케어봇 📞 연락처 버튼이 회신할 연락처 (미설정 시 "미등록"으로 표시)
care_contact_caregiver=담당 요양사 홍길동 010-0000-0000
care_contact_manager=관리자 김철수 010-1111-1111

# ── [시연용] MoveNet 관절 오버레이 ──────────────────────────────
# 1로 켜면 Qt로 나가는 영상 위에 MoveNet 관절 17개(점·뼈대)와 판정 상태를 그린다.
# 사람이 잡히면 초록 스켈레톤, "누움" 판정이 나면 빨강 + LYING 라벨로 바뀌므로
# 낙상 감지가 무엇을 보고 판단하는지 영상으로 보여줄 수 있다.
#  · Qt·프로토콜은 그대로다 — 서버가 인코딩 직전 프레임에 직접 그린다.
#  · 송출본에만 그린다 — Gemini·텔레그램으로 나가는 스냅샷엔 안 들어간다.
#  · 시연이 끝나면 0으로 되돌릴 것(CPU와 화면을 그대로 되돌린다).
pose_overlay=0
# 자세 추론 주기 두 개. 운영 기본값(2초/명, 0.25초/채널)은 CPU를 아끼는 값이라
# 오버레이를 켜도 점이 2초에 한 번만 움직인다. 시연에선 아래처럼 줄일 것.
# 사람이 1~2명일 때 기준(Thunder 추론 1회 ~100ms) — 인원이 많으면 다시 올릴 것.
pose_interval_sec=0.3
ai_job_interval_sec=0.15

# (A) 부팅 즉시 연결 — URL을 직접 지정
0=rtsp://admin:비밀번호@172.20.35.140:554/0/profile2/media.smp
1=rtsp://admin:비밀번호@172.20.35.140:554/1/profile2/media.smp
2=rtsp://admin:비밀번호@172.20.35.140:554/2/profile2/media.smp
3=rtsp://admin:비밀번호@172.20.35.140:554/3/profile2/media.smp

# (B) 런타임 지정 — Qt "카메라 연결"로 IP를 넣을 때까지 대기 (2-Pi의 Pi A 예)
#   URL 없이 담당 채널만 선언한다. (위 (A) 4줄은 지우고 아래처럼)
# 0=
# 1=
