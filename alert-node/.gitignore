# 최종 커널 모듈 바이너리
*.ko


# 컴파일 과정에서 생성되는 오브젝트 및 임시 파일들
*.o
*.o.cmd
*.mod
*.mod.c
*.mod.o
*.mod.cmd
*.ko.cmd


# 커널 빌드 시스템(kbuild)이 생성하는 체크섬 및 메타데이터
.tmp_versions/
modules.order
Module.symvers
.modules.order.cmd
.Module.symvers.cmd


# 빌드 디렉토리 내부의 숨김 명령 파일들
.*.cmd

# DTS 컴파일 결과물인 바이너리 파일
*.dtb
*.dtbo


# Vim 백업 및 스왑 파일
.*.sw[a-p]
*~


# 유저스페이스 앱 실행 파일 - 확장자가 없어 패턴으로 안 잡히니 이름으로 적는다
# 앱을 추가하면 여기에 한 줄 추가할 것
app/matrix/hub75-alert
app/AudioPlayer/veda_player
app/AudioPlayer/2veda_player


# hub75 데모용 미디어 - 원본에서 재생성 가능하고 용량이 커서 넣지 않는다
drivers/hub75/*.rgb
drivers/hub75/*.mp4
drivers/hub75/*.gif
drivers/hub75/*.webp
drivers/hub75/*.svg
