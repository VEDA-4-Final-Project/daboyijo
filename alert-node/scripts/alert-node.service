# 알림 노드 — 부팅하면 바로 뜨고, 죽으면 다시 뜬다
#
# 설치 (기기당 한 번):
#   sudo cp alert-node/scripts/alert-node.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now alert-node
#
#   로그   journalctl -u alert-node -f
#   배포   make -C alert-node/app && sudo systemctl restart alert-node
#
# 아래 경로는 저장소 작업 트리를 그대로 가리킨다. 기기마다 체크아웃 위치가
# 다르면 여기 세 줄을 고쳐야 한다. 빌드한 자리에서 바로 도는 대신, 브랜치를
# 옮기거나 트리를 지우면 서비스도 같이 깨진다는 뜻이기도 하다.

[Unit]
Description=daboyijo 알림 노드 (MQTT -> 사이렌 + HUB75 LED)

# 브로커가 원격이라 네트워크가 선 다음에 뜬다. 그래도 부팅 순간에는 브로커 쪽
# 파이가 아직 안 떠 있을 수 있는데, 그건 아래 Restart 가 맡는다.
Wants=network-online.target
After=network-online.target

# 최초 연결에 실패하면 노드가 일부러 종료한다(main.cpp 의 그 주석 — 살아는 있는데
# 알림만 안 오는 상태가 제일 찾기 어렵다). 그 설계는 systemd 가 계속 다시 띄워
# 준다는 전제 위에 있다. 이 줄이 없으면 기본 제한(10초에 5번)에 걸려서, 브로커가
# 조금 늦게 뜨는 날 알림 노드가 영영 안 올라온다.
StartLimitIntervalSec=0

[Service]
Type=simple

# root 여야 한다 — 커널 모듈 insmod 와 /sys/module/hub75/parameters/brightness 쓰기.
User=root

# wm8960(오디오)과 hub75(패널) 모듈을 먼저 올린다. 이미 올라와 있으면 건너뛰도록
# 되어 있어서 재시작 때마다 불려도 무해하다.
ExecStartPre=/home/yehoon/FinalProject/daboyijo/alert-node/scripts/load.sh

# stdbuf 가 없으면 stdout 이 journald 파이프에 물려 블록 버퍼가 된다. 그러면
# 로그가 실시간으로 안 보이고 한참 뒤에 몰려 나온다(README 의 그 이야기).
ExecStart=/usr/bin/stdbuf -oL /home/yehoon/FinalProject/daboyijo/alert-node/app/alert-node

Restart=always
RestartSec=5

# 정지 신호를 받으면 브로커에 offline 을 알리고 패널을 끄고 나간다. 노드가 스스로
# 5초 안에 끝내도록 되어 있어(SHUTDOWN_LIMIT_SEC) 그보다 넉넉히 준다.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
